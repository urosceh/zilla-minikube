# Canonical parameters for thesis-grade fixed-cost comparisons.
# Keep this file as the single source of truth for run-fair-comparison.sh.

FAIR_COMPARISON_PROTOCOL=fixed-cost-v1
FAIR_COMPARISON_MODELS="iso hybrid shared"
FAIR_COMPARISON_REPETITIONS=3
FAIR_COMPARISON_WARMUP_SECONDS=30
FAIR_COMPARISON_STEADY_SECONDS=120
FAIR_COMPARISON_COOLDOWN_SECONDS=30
FAIR_COMPARISON_VUS_PER_TENANT=2
FAIR_COMPARISON_THINK_TIME_SECONDS=0.25
