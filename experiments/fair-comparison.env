# Canonical parameters for thesis-grade fixed-cost comparisons.
# Keep this file as the single source of truth for run-fair-comparison.sh.

FAIR_COMPARISON_PROTOCOL=fixed-cost-v2
FAIR_COMPARISON_MODELS="iso shared"
FAIR_COMPARISON_REPETITIONS=3
FAIR_COMPARISON_ISO_TENANTS="arm"
FAIR_COMPARISON_SHARED_TENANTS="amazon,amd,apple,azure,google,meta,netflix,nvidia,paypal,reddit"
FAIR_COMPARISON_WARMUP_SECONDS=60
FAIR_COMPARISON_STEADY_SECONDS=180
FAIR_COMPARISON_COOLDOWN_SECONDS=30
FAIR_COMPARISON_VUS_PER_TENANT=20
FAIR_COMPARISON_THINK_TIME_MIN_SECONDS=0.25
FAIR_COMPARISON_THINK_TIME_MAX_SECONDS=0.5
